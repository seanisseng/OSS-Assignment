      "body": "from playwright.sync_api import sync_playwright, expect\nfrom datetime import datetime\nimport sys\nimport traceback\n\nURL = \"https://the-internet.herokuapp.com/login\"\nUSER = \"tomsmith\"\nPASS = \"SuperSecretPassword!\"\n\nHEADLESS = True\n\nRELATORIO = \"relatorio_login.html\"\nSCREEN_OK = \"login_success.png\"\nSCREEN_FAIL = \"login_fail.png\"\n\n\ndef gerar_relatorio(status, mensagem, screenshot):\n    data = datetime.now().strftime(\"%d/%m/%Y %H:%M:%S\")\n\n    html = f\"\"\"\n    <html>\n    <head>\n        <meta charset=\"utf-8\">\n        <title>Evidência de Teste</title>\n        <style>\n            body {{ font-family: Arial; margin: 30px; }}\n            .ok {{ color: green; font-weight: bold; }}\n            .fail {{ color: red; font-weight: bold; }}\n            img {{ margin-top: 15px; max-width: 100%; border: 1px solid #ccc; }}\n        </style>\n    </head>\n    <body>\n        <h1>Evidência de Login</h1>\n        <p><b>Data:</b> {data}</p>\n        <p><b>Status:</b>\n            <span class=\"{ 'ok' if status == 'SUCESSO' else 'fail' }\">{status}</span>\n        </p>\n        <p><b>Resultado:</b> {mensagem}</p>\n        {f'<img src=\"{screenshot}\">' if screenshot else ''}\n    </body>\n    </html>\n    \"\"\"\n\n    with open(RELATORIO, \"w\", encoding=\"utf-8\") as f:\n        f.write(html)\n\n\ndef main():\n    browser = None\n\n    try:\n        with sync_playwright() as p:\n            print(\"▶ Rodando evidência de login...\")\n\n            browser = p.chromium.launch(headless=HEADLESS)\n            page = browser.new_page(viewport={\"width\": 1280, \"height\": 720})\n\n            page.goto(URL, wait_until=\"domcontentloaded\", timeout=30000)\n\n            page.fill(\"#username\", USER)\n            page.fill(\"#password\", PASS)\n\n            with page.expect_navigation():\n                page.click(\"button[type=submit]\")\n\n            expect(page.locator(\"#flash\")).to_contain_text(\n                \"You logged into a secure area!\",\n                timeout=15000\n            )\n\n            page.screenshot(path=SCREEN_OK, full_page=True)\n            gerar_relatorio(\"SUCESSO\", \"Login realizado com sucesso\", SCREEN_OK)\n\n            print(\"✔ Concluído com sucesso\")\n\n    except Exception as e:\n        print(\"✖ Falha na execução\")\n\n        erro = \"\".join(traceback.format_exception_only(type(e), e)).strip()\n\n        if 'page' in locals():\n            page.screenshot(path=SCREEN_FAIL, full_page=True)\n            gerar_relatorio(\"FALHA\", erro, SCREEN_FAIL)\n        else:\n            gerar_relatorio(\"FALHA\", erro, \"\")\n\n        sys.exit(1)\n\n    finally:\n        if browser:\n            browser.close()\n\n\nif _name_ == \"_main_\":\n    main()\n\npip install playwright\nplaywright install chromium --with-deps\n\n\npython run_login.py/``",
